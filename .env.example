# 复制成 .env.local 后按需填写。全部不填也能在本地跑（内嵌数据库、模板生成教案）。

# PostgreSQL 连接串。不填则用内嵌的 PGlite，数据存在 .data/pglite
# DATABASE_URL=postgres://user:pass@host:5432/ku

# 会话签名密钥，生产环境必填，至少 32 个字符：openssl rand -base64 32
SESSION_SECRET=

# 启动时确保存在这个邀请码（最多 1000 次使用）。开发环境默认 KU-DEMO，生产环境不填就不创建
# SEED_INVITE=KU-DEMO

# OpenAI 兼容的大模型接口。不填则教案用模板生成。国内上线请用已备案的模型服务
# LLM_BASE_URL=https://api.example.com/v1
# LLM_API_KEY=
# LLM_MODEL=
